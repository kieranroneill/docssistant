# shared configuration
DESCRIPTION="The description of the application."
ENVIRONMENT="The type of environment: 'development', 'production' or 'test'"
LOG_LEVEL="The level to display log messages. Use: 'DEBUG' | 'ERROR' | 'INFO' | 'MOTSET' | 'WARN'"
TITLE="The title of the application."

# api configuration
API_BASE_URL="Full base URL, including the port, of the API that is accessible from within Docker, i.e. 'http://api:3000'"
API_PORT="The port of the API, i.e. 3000"
API_RELOAD="Whether the API relaods"

# chroma
CHROMA_COLLECTION="The name of the Chroma collection"
CHROMA_HOST="The host that Chroma is accessible from externally, i.e. 127.0.0.1"
CHROMA_PORT="The exposed port that Chroma is accessible to externally, i.e. 8000"

# ollama configuration
OLLAMA_BASE_URL="The base URL of the Ollama service that is accessible from within Docker, i.e. http://ollama:11434"
OLLAMA_CHAT_MODEL="The name of the Ollama chat model, e.g. qwen3:4b"
OLLAMA_CHAT_TIMEOUT="Seconds to wait for the chat model before giving up, i.e. 180"
OLLAMA_EMBEDDING_MODEL="The name of the Ollama document embedding model, e.g. nomic-embed-text"
OLLAMA_EMBEDDING_TIMEOUT="Seconds to wait for the embedding model before giving up, i.e. 60"
OLLAMA_HOST="The host that Ollama is accessible from externally, i.e. 127.0.0.1"
OLLAMA_PORT="The exposed port that Ollama is accessible from externally, i.e. 11434"

# postgres
POSTGRES_DB="Name of the Postgres database, i.e. 'docssistant'"
POSTGRES_HOST="The host that Postgres is accessible to externally, i.e. 127.0.0.1"
POSTGRES_PASSWORD="Password for the Postgres user"
POSTGRES_PORT="The exposed port that Postgres is accessible to externally, i.e. 5342"
POSTGRES_USER="Username for the Postgres user"
POSTGRES_SSL_MODE="Whether to run Postgre in SSL mode, i.e. 'disable' or 'enable'."
