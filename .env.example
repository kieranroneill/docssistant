# shared configuration
DESCRIPTION="The description of the application."
ENVIRONMENT="The type of environment: 'development', 'production' or 'test'"
LOG_LEVEL="The level to display log messages. Use: 'debug' | 'error' | 'info' | 'silent' | 'warn'"
TITLE="The title of the application."

# api configuration
API_BASE_URL="Full base URL, including the port, of the API, i.e. 'http://localhost:3000'"
API_PORT="Port of the API, i.e. '3000'"
API_RELOAD="Whether the API relaods"

# ollama
OLLAMA_MODEL="The name of the Ollama model that LangChain will use, e.g. qwen3:4b"
OLLAMA_BASE_URL="The base URL of the Ollama model"

# postgres
POSTGRES_DB="Name of the database, i.e. 'docssistant'"
POSTGRES_HOST="Host of the database, i.e. 'localhost'"
POSTGRES_PASSWORD="Password for the user"
POSTGRES_PORT="Port of the database, i.e. '5432'"
POSTGRES_USER="Username for the user"
POSTGRES_SSL_MODE="Whether to run PostgreSQL in SSL mode, i.e. 'disable' or 'enable'."
