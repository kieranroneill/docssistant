# shared configuration
DESCRIPTION="Docssistant is a document chat assistant that uses retrieval-augmented generation (RAG) to answer questions about your documents and cite its sources."
ENVIRONMENT=test
LOG_LEVEL=NOTSET
TITLE="Docssistant Test"

# api configuration
API_BASE_URL=http://api:3001
API_PORT=3001
API_RELOAD=false

# chroma
CHROMA_COLLECTION=document_chunks_nomic_v1
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001

# ollama configuration
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=test-chat-model
OLLAMA_EMBEDDING_MODEL=test-embed-model
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11435

# database
POSTGRES_DB=docssistant
POSTGRES_HOST=127.0.0.1
POSTGRES_PASSWORD=password
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_SSL_MODE=disable
